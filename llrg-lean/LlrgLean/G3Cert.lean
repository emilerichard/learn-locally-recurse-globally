/-
Appendix F: every function of 4 inputs is in `G_3(4)`, by a certificate checked by the kernel.
For each of the `2^16` truth tables `c`, the certificate gives a depth-3 witness: either `c = a ⊕ b`
with `a, b ∈ G_2(4)`, or `c` is an AND (resp. OR) of at most four elements of `G_2(4)`. Membership
in `G_2(4)` is the bitmap `g2map 4`, proved equal to the literal `B4` by kernel computation, and
specified by `G2_iff`. The certificate was produced by a search outside Lean; only its check
matters for correctness.
-/
import LlrgLean.ClassCount

namespace Llrg.Count

set_option maxRecDepth 100000

/-- The depth-2 bitmap for `N = 4`, as a literal. -/
def B4 : ℕ := 

theorem g2map4_eq : g2map 4 = B4 := by decide +kernel


/-- Field `i` (66 bits) of a certificate chunk: the packed witness of one truth table. -/
def entry (ch i : ℕ) : ℕ := (ch >>> (66 * i)) % 2 ^ 66

def fld (w k : ℕ) : ℕ := (w >>> (2 + 16 * k)) % 2 ^ 16

/-- Check of a packed witness `w` for truth table `c` against the depth-2 bitmap `B`:
tag `w % 4` is 0 for `c = a ⊕ (c ⊕ a)`, 1 for an AND of four operands, 2 for an OR. -/
def chk (B c w : ℕ) : Bool :=
  if w % 4 = 0 then B.testBit (fld w 0) && B.testBit (c ^^^ fld w 0)
  else if w % 4 = 1 then B.testBit (fld w 0) && B.testBit (fld w 1) && B.testBit (fld w 2) &&
    B.testBit (fld w 3) && (fld w 0 &&& fld w 1 &&& fld w 2 &&& fld w 3 == c)
  else if w % 4 = 2 then B.testBit (fld w 0) && B.testBit (fld w 1) && B.testBit (fld w 2) &&
    B.testBit (fld w 3) && (fld w 0 ||| fld w 1 ||| fld w 2 ||| fld w 3 == c)
  else false

def chunk0 : ℕ := 
theorem cert0 : ∀ i < 256, chk B4 (0 * 256 + i) (entry chunk0 i) = true := by
  decide +kernel

